# Copy to /opt/abavava/.env.production on the VPS. Never commit the filled file.
ABV_DOMAIN=chat.example.com
ABV_DATABASE_PASSWORD=replace-with-a-long-random-password
ABV_JWT_SECRET=replace-with-at-least-32-random-characters
ABV_LOG_LEVEL=info

# TURN is initialized on the VPS by the deployment workflow.
# It creates credentials if missing and uses ABV_DOMAIN on UDP port 3478.
ABV_TURN_URL=
ABV_TURN_USERNAME=
ABV_TURN_CREDENTIAL=

# Transactional mail (email verification codes).
# Postfix runs on the VPS host; the api container reaches it via
# host.docker.internal:25 (extra_hosts is set in compose.prod.yaml).
# For an external relay set ABV_MAIL_HOST/PORT/USERNAME/PASSWORD and
# ABV_MAIL_STARTTLS=true (587) or ABV_MAIL_SSL=true (465).
ABV_MAIL_ENABLED=true
ABV_MAIL_HOST=host.docker.internal
ABV_MAIL_PORT=25
ABV_MAIL_USERNAME=
ABV_MAIL_PASSWORD=
ABV_MAIL_STARTTLS=false
ABV_MAIL_SSL=false
# From/Support/App URL are required: compose.prod.yaml fails fast if they are
# empty, because a letter from a local domain lands in spam and a localhost
# link breaks the "Copy code" button.
ABV_MAIL_FROM=no-reply@chat.example.com
ABV_MAIL_SUPPORT_EMAIL=support@chat.example.com
ABV_MAIL_APP_URL=https://chat.example.com

# Manual code sending: POST /api/v1/auth/send-code.
# off — disabled (404), dev — only outside production (404 in production),
# on  — public with resend cooldown and per-account hourly limits.
ABV_EMAILVERIFICATION_SENDCODE=dev
