# Базовый URL backend. Пустое значение = тот же origin (в dev работает Vite proxy на /api).
# Пример: VITE_API_BASE=http://localhost:8080
VITE_API_BASE=

# --- Жизненный цикл звонка: статистика, ICE restart, телеметрия ---
# Все значения необязательны: дефолты в src/lib/call-config.ts. Пустая строка
# или 0 — дефолт (кроме явно допустимых нулей вроде VITE_CALL_ICE_RESTART_MAX_ATTEMPTS=0).
#
# Частота getStats: обычная, при деградации и во время ICE restart.
# VITE_CALL_STATS_INTERVAL_MS=2000
# VITE_CALL_STATS_DEGRADED_INTERVAL_MS=1000
# VITE_CALL_STATS_RESTART_INTERVAL_MS=500
# VITE_CALL_STATS_TELEMETRY_INTERVAL_MS=5000
#
# Восстановление ICE: ожидание самостоятельного восстановления, таймаут
# попытки, число попыток (0 — ICE restart выключен), база и потолок backoff.
# VITE_CALL_DISCONNECTED_GRACE_MS=5000
# VITE_CALL_ICE_RESTART_ATTEMPT_TIMEOUT_MS=15000
# VITE_CALL_ICE_RESTART_MAX_ATTEMPTS=3
# VITE_CALL_ICE_RESTART_BACKOFF_BASE_MS=2000
# VITE_CALL_ICE_RESTART_BACKOFF_MAX_MS=15000
#
# Телеметрия: размер batch, период отправки, предел буфера (backpressure),
# число retry и задержки (экспоненциальные).
# VITE_CALL_TELEMETRY_BATCH_SIZE=20
# VITE_CALL_TELEMETRY_FLUSH_INTERVAL_MS=5000
# VITE_CALL_TELEMETRY_MAX_BUFFER=200
# VITE_CALL_TELEMETRY_MAX_RETRIES=3
# VITE_CALL_TELEMETRY_RETRY_BASE_MS=1000
# VITE_CALL_TELEMETRY_RETRY_MAX_MS=10000

